{
  "name": "mcp-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -b packages/shared packages/device",
    "typecheck": "tsc -b packages/shared packages/device",
    "test": "vitest run",
    "device": "tsx packages/device/src/cli.ts",
    "server": "cd server && go run ./cmd/relay"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}

